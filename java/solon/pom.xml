<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.wuyuan2009123</groupId>
    <artifactId>simdpaddleocr-parent</artifactId>
    <version>1.0.0</version>
  </parent>

  <artifactId>simdpaddleocr-solon</artifactId>
  <name>SimdPaddleOCR Solon server</name>

  <dependencies>
    <dependency>
      <groupId>io.github.wuyuan2009123</groupId>
      <artifactId>simdpaddleocr4j</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.noear</groupId>
      <artifactId>solon-web</artifactId>
      <version>${solon.version}</version>
    </dependency>
    <dependency>
      <groupId>org.noear</groupId>
      <artifactId>solon-serialization-jackson</artifactId>
      <version>${solon.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Solon has no equivalent of spring-boot-maven-plugin, so shade it into a runnable jar. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.github.wuyuan2009123.simdpaddleocr.solon.SolonOcrApp</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
